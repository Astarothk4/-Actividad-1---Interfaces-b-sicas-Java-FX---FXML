<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.ejercicio1.gastossemanales.PrimaryController">

    <Label text="Control de Gastos Semanales"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="12.0" vgap="12.0">

        <Label text="Alimentación"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtAlimentacion" text="0"
                   prefWidth="100.0"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Refrigerios"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtRefrigerios" text="0"
                   prefWidth="100.0"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Transporte"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtTransporte" text="0"
                   prefWidth="100.0"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Telefonía"
               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtTelefonia" text="0"
                   prefWidth="100.0"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Otros"
               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtOtros" text="0"
                   prefWidth="100.0"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Estadísticas"
               style="-fx-font-weight: bold;"
               GridPane.columnIndex="2" GridPane.rowIndex="0"/>

        <Label text="Total semanal"
               GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTotal" editable="false"
                   prefWidth="110.0"
                   GridPane.columnIndex="2" GridPane.rowIndex="2"/>

        <Label text="Gasto más alto"
               GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <TextField fx:id="txtGastoMayor" editable="false"
                   prefWidth="130.0"
                   GridPane.columnIndex="2" GridPane.rowIndex="4"/>

    </GridPane>

    <HBox alignment="CENTER" spacing="12.0">
        <Button text="Calcular estadísticas"
                onAction="#calcularEstadisticas"
                wrapText="true"
                prefWidth="130.0"
                prefHeight="50.0"/>

        <Button text="Limpiar"
                onAction="#limpiar"
                prefWidth="90.0"
                prefHeight="50.0"/>
    </HBox>

</VBox>
