<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18.0"
      prefWidth="430.0" prefHeight="410.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ejercicio1.conbaseaunacantidadenteradedinero.PrimaryController">

    <padding>
        <Insets top="15.0" right="20.0"
                bottom="15.0" left="20.0"/>
    </padding>

    <Label text="Desglose de dinero"
           style="-fx-font-size: 20px;"/>

    <HBox alignment="CENTER" spacing="8.0">
        <Label text="Dinero:"/>

        <TextField fx:id="txtDinero"
                   text="9999"
                   prefWidth="130.0"/>

        <Button text="X"
                onAction="#limpiar"/>

        <Button text="Desglosar"
                onAction="#desglosarDinero"/>
    </HBox>

    <HBox alignment="CENTER" spacing="12.0">

        <VBox spacing="5.0"
              prefWidth="185.0"
              style="-fx-border-color: #777777;
                     -fx-border-width: 1;
                     -fx-padding: 10;">

            <Label text="Billetes de $500"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Billetes de $200"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Billetes de $100"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Billetes de $50"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Billetes de $20"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Monedas de $10"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Monedas de $5"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Monedas de $2"
                   minHeight="20.0" maxWidth="Infinity"/>
            <Label text="Monedas de $1"
                   minHeight="20.0" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="5.0"
              prefWidth="145.0"
              style="-fx-border-color: #777777;
                     -fx-border-width: 1;
                     -fx-padding: 10;">

            <Label fx:id="lbl500" text="19"
                   minHeight="20.0"/>
            <Label fx:id="lbl200" text="2"
                   minHeight="20.0"/>
            <Label fx:id="lbl100" text="0"
                   minHeight="20.0"/>
            <Label fx:id="lbl50" text="1"
                   minHeight="20.0"/>
            <Label fx:id="lbl20" text="2"
                   minHeight="20.0"/>
            <Label fx:id="lbl10" text="0"
                   minHeight="20.0"/>
            <Label fx:id="lbl5" text="1"
                   minHeight="20.0"/>
            <Label fx:id="lbl2" text="2"
                   minHeight="20.0"/>
            <Label fx:id="lbl1" text="0"
                   minHeight="20.0"/>
        </VBox>

    </HBox>

</VBox>