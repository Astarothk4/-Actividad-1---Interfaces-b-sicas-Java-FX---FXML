<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.ejercicio1.tablademultiplicar.PrimaryController">

    <Label text="Tabla de multiplicar" />

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Ingrese un número:" />
        <TextField fx:id="txtNumero" prefWidth="100.0" />
    </HBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button text="Calcular tabla" onAction="#calcularTabla" />
        <Button text="Limpiar" onAction="#limpiar" />
    </HBox>

    <ListView fx:id="listaResultados"
              prefWidth="260.0"
              prefHeight="300.0" />

</VBox>
