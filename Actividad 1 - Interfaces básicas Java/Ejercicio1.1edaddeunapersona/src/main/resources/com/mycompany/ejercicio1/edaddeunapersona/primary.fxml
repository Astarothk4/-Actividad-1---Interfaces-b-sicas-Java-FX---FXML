<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18.0"
      prefWidth="380.0" prefHeight="250.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ejercicio1.edaddeunapersona.PrimaryController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Edad de una persona"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Fecha de nacimiento:"/>
        <TextField fx:id="txtFecha"
                   promptText="dd/mm/aaaa"
                   prefWidth="120.0"/>
    </HBox>

    <HBox alignment="CENTER" spacing="12.0">
        <Button text="Calcular" onAction="#calcularEdad"/>
        <Button text="Limpiar" onAction="#limpiar"/>
    </HBox>

    <Label fx:id="lblResultado"
           text="Aquí aparecerá tu edad"
           wrapText="true"/>
</VBox>
