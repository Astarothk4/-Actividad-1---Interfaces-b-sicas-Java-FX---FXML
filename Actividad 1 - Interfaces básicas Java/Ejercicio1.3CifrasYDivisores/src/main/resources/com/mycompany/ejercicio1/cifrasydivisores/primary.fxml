<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>

<VBox alignment="CENTER" spacing="15.0"
      prefWidth="540.0" prefHeight="480.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.ejercicio1.cifrasydivisores.PrimaryController">

    <padding>
        <Insets top="15.0" right="20.0"
                bottom="15.0" left="20.0"/>
    </padding>

    <Label text="Cifras y Divisores de un Número"
           style="-fx-font-size: 18px;"/>

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Ingrese un número:"/>
        <TextField fx:id="txtNumero"
                   text="6915"
                   prefWidth="110.0"/>
        <Button text="Analizar"
                onAction="#analizar"/>
        <Button text="Limpiar"
                onAction="#limpiar"/>
    </HBox>

    <HBox spacing="25.0" alignment="TOP_CENTER">

        <GridPane hgap="8.0" vgap="8.0">
            <Label text="Cantidad de cifras" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtCantidad" editable="false" prefWidth="75.0" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Suma cifras impares" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtImpares" editable="false" prefWidth="75.0" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Suma cifras pares" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPares" editable="false" prefWidth="75.0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Suma total de cifras" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtSuma" editable="false" prefWidth="75.0" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Cifra mayor" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMayor" editable="false" prefWidth="75.0" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Cifra menor" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="txtMenor" editable="false" prefWidth="75.0" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>

        <VBox spacing="8.0" prefWidth="160.0">
            <Label text="Divisores"/>
            <ListView fx:id="listaDivisores"
                      prefWidth="160.0"
                      prefHeight="260.0"/>
        </VBox>

    </HBox>

</VBox>
